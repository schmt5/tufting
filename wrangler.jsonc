{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tufting",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  // Stylesheet und Font liegen in ./public und werden direkt ausgeliefert —
  // ohne Worker-Invocation. Für "/" gibt es keine Datei, also übernimmt der Worker.
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  // Öffentliche Werte. Lokal überschreibt .dev.vars sie (siehe .dev.vars.example).
  "vars": {
    // Dev-Phase: die öffentlichen Test-Schlüssel von Cloudflare. Sie bestehen
    // immer (siteverify meldet dafür example.com) und schützen also nicht vor
    // Bots. Vor dem Livegang: echtes Widget für die Domain anlegen, Sitekey und
    // Domain hier eintragen, das echte Secret als TURNSTILE_SECRET_KEY setzen.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_HOSTNAMES": "example.com"
  },
  // Täglich 03:00 UTC: alte Anmeldungen und Login-Fehlversuche löschen (cleanup.ts).
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  // Termine und Anmeldungen. Angelegt mit `--jurisdiction eu`: die Daten
  // liegen und werden verarbeitet nur in der EU. Lokal liegt die Datenbank
  // unter .wrangler/state. Schema in ./migrations, siehe plan.md §4.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tufting",
      "database_id": "e6024c40-9c67-4e01-8343-e10d40059de7",
      "migrations_dir": "./migrations"
    }
  ]
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // }
}