{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tufting",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  // Stylesheet und Font liegen in ./public und werden direkt ausgeliefert —
  // ohne Worker-Invocation. Für "/" gibt es keine Datei, also übernimmt der Worker.
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  // Öffentliche Werte. Lokal überschreibt .dev.vars sie (siehe .dev.vars.example).
  "vars": {
    // `tally` bis zur Umstellung in Phase 6, dann `d1` (plan.md §12).
    "SIGNUP_BACKEND": "tally",
    // Sitekey des Turnstile-Widgets und die Domain der Seite — gesetzt, sobald
    // das Widget für die Zieldomain angelegt ist. Nie localhost.
    "TURNSTILE_SITE_KEY": "",
    "TURNSTILE_HOSTNAMES": "",
    // Öffentlicher Teil des VAPID-Paars für Web Push; der private liegt als
    // Secret VAPID_PRIVATE_KEY. Neue Schlüssel heissen: alle Geräte neu anmelden.
    "VAPID_PUBLIC_KEY": "BK_X2bPonW4fPM0b-8pzDTq3fdcVgoTSfw72CkyRSv22LD7fNT8u9rgcFrYByM4180akU9uyStL4jxkVUw1q0Xk",
    "VAPID_SUBJECT": "mailto:tuftingstudio.bern@outlook.com"
  },
  // Täglich 03:00 UTC: alte Anmeldungen und Login-Fehlversuche löschen (cleanup.ts).
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  // Termine und Anmeldungen. Angelegt mit `--jurisdiction eu`: die Daten
  // liegen und werden verarbeitet nur in der EU. Lokal liegt die Datenbank
  // unter .wrangler/state. Schema in ./migrations, siehe plan.md §4.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tufting",
      "database_id": "e6024c40-9c67-4e01-8343-e10d40059de7",
      "migrations_dir": "./migrations"
    }
  ]
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // }
}